# For Supabase PostgreSQL (Shared Cloud DB for Team):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Redis Setup (Optional, Upstash Cloud Redis or Local)
