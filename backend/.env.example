# SWASTH SAARTHI / AYUR SAARTHI - ENVIRONMENT CONFIGURATION
# (Copy this to backend/.env and fill in the values)

# Database Setup (Supports Supabase PostgreSQL or local SQLite fallback)
DATABASE_URL=sqlite:///./swasthsaarthi.db
# For Supabase PostgreSQL (Shared Cloud DB for Team):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Redis Setup (Optional, Upstash Cloud Redis or Local)
REDIS_URL=redis://localhost:6379

# Google Gemini API Key (Required for AyurSaarthi AI Summaries & Triage)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_KEY_HERE

# ElevenLabs API Key (Required for AI Voice Narration)
ELEVENLABS_API_KEY=el_YOUR_ELEVENLABS_KEY_HERE

# Groq API Key (Optional for ultra-fast Whisper Speech-to-Text rotation)
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE

# JWT Secret for Authentication
JWT_SECRET=swasth_saarthi_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMS OTP via Fast2SMS
# 1. Sign up at https://www.fast2sms.com
# 2. Go to Dev API section in dashboard and copy your API key
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE

# Email OTP via Gmail SMTP (App Password — NOT your real Gmail password)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to myaccount.google.com → Security → App Passwords
# 3. Create an App Password for "Mail" → copy the 16-char key
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# App Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
